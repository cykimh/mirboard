{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [":server:bootRun"],
      "port": 8080
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5173
    },
    {
      "name": "starsquare-trial",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5203", "--bind", "127.0.0.1", "--directory", "scripts/starsquare-trial"],
      "port": 5203
    },
    {
      "name": "starsquare-server",
      "runtimeExecutable": "env",
      "runtimeArgs": ["MIRBOARD_PORT=8203", "MIRBOARD_REDIS_DATABASE=7", "MIRBOARD_DB_SCHEMA=sq_dev", "MIRBOARD_ALLOWED_ORIGINS=http://localhost:5203", "MIRBOARD_STAR_SQUARE_STATUS=AVAILABLE", "./gradlew", ":server:bootRun"],
      "port": 8203
    },
    {
      "name": "starsquare-client",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_PORT=5203", "MIRBOARD_DEV_API=http://localhost:8203", "npm", "--prefix", "client", "run", "dev"],
      "port": 5203
    },
    {
      "name": "wordtemp-server",
      "runtimeExecutable": "env",
      "runtimeArgs": ["MIRBOARD_PORT=8219", "MIRBOARD_REDIS_DATABASE=9", "MIRBOARD_DB_SCHEMA=wt_dev", "MIRBOARD_ALLOWED_ORIGINS=http://localhost:5219", "MIRBOARD_WORD_TEMP_STATUS=AVAILABLE", "MIRBOARD_RATELIMIT_ENABLED=false", "MIRBOARD_GUEST_DAILY_CAP=100000", "./gradlew", ":server:bootRun"],
      "port": 8219
    },
    {
      "name": "wordtemp-client",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_PORT=5219", "MIRBOARD_DEV_API=http://localhost:8219", "npm", "--prefix", "client", "run", "dev"],
      "port": 5219
    }
  ]
}
