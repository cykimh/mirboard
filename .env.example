# Mirboard 환경 변수 레퍼런스 (.env.example)
#
# 이 파일은 git 에 추적되는 "키 목록 + 더미값" 레퍼런스다 (.gitignore 의 `!.env.example`).
# 실제 시크릿은 절대 여기에 넣지 말 것 — 로컬은 `.env`(gitignore), prod 는 `flyctl secrets set`.
#
# 로컬 개발은 application.yml 에 안전한 기본값(localhost Postgres/Redis, dev JWT 시크릿)이
# 박혀 있어 아무것도 설정하지 않아도 `docker compose up -d postgres redis` 후 기동된다.
# 아래 값은 그 기본값을 덮어쓰거나 prod 배포 시 주입하는 용도.

# ─── 필수 (prod) / 로컬은 기본값 있음 ───────────────────────────────

# JWT HS256 서명 키 — 32바이트 이상. 예: openssl rand -hex 32
MIRBOARD_JWT_SECRET=replace-with-32-byte-min-random-secret

# DB: 전체 jdbc URL 을 통째로 주거나(Fly/Supabase 형) 아래 조각으로 조합.
MIRBOARD_DB_URL=jdbc:postgresql://127.0.0.1:5432/mirboard
# (URL 미설정 시 조각으로 조합) ─ MIRBOARD_DB_HOST / _PORT / _NAME
MIRBOARD_DB_HOST=127.0.0.1
MIRBOARD_DB_PORT=5432
MIRBOARD_DB_NAME=mirboard
MIRBOARD_DB_USER=mirboard
MIRBOARD_DB_PASSWORD=mirboardpw

# Redis (실시간 세션/방 상태). 매니지드(Upstash 등)는 비밀번호 + TLS 필수.
MIRBOARD_REDIS_HOST=127.0.0.1
MIRBOARD_REDIS_PORT=6379
MIRBOARD_REDIS_PASSWORD=
MIRBOARD_REDIS_SSL=false

# ─── 선택 / 토글 ────────────────────────────────────────────────

# 활성 프로필. prod 는 application-prod.yml(redis 게이트웨이·TLS 강제) 적용.
SPRING_PROFILES_ACTIVE=
# HTTP 포트.
MIRBOARD_PORT=8080
# 메시징 fan-out: in-memory(단일 인스턴스 기본) | redis(멀티 인스턴스).
MIRBOARD_MESSAGING_GATEWAY=in-memory
# 봇 액션 사이 딜레이(ms). IT 는 0 으로 override.
MIRBOARD_BOT_DELAY_MILLIS=700
# IN_GAME 탈주 확정 유예(초). 모바일 관용 기본 120.
MIRBOARD_DESERTION_GRACE_SECONDS=120

# ─── 보안 (D-83 / D-84) ─────────────────────────────────────────

# CORS 허용 origin 화이트리스트(콤마 구분). dev=Vite/로컬, prod=실도메인.
MIRBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# 인증 레이트리밋 / 로그인 잠금은 application.yml 의 mirboard.ratelimit.* /
# mirboard.auth.lockout.* 기본값을 사용(전부 Redis 휘발, users 스키마 비침범).
# 필요 시 동일 prefix 의 env(예: MIRBOARD_RATELIMIT_AUTH_CAPACITY)로 override.
